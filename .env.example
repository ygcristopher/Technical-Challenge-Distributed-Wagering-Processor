NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_CONSUMER_NAME=wagering-sqs-consumer
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_WAIT_SECONDS=10
SQS_CONSUMER_VISIBILITY_TIMEOUT=30
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=1000
OUTBOX_PUBLISHER_BATCH_SIZE=25
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_WORKER_INTERVAL_MS=1000
